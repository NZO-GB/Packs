{
  "format_version": "1.26.0",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:cod",
      "spawn_category": "water_creature",
      "is_spawnable": true,
      "is_summonable": true
    },
    "component_groups": {
      "rally:rallied": {
        "minecraft:health": {
          "max": 9,
          "value": 9
        },
        "minecraft:attack": {
          "damage": 1
        },
        "minecraft:underwater_movement": {
          "value": 0.25
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "must_see": true,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "monster"
              }
            }
          ]
        },
        "minecraft:behavior.melee_attack": {
          "priority": 0,
          "speed_multiplier": 1.2
        },
        "minecraft:timer": {
          "looping": false,
          "time": 640,
          "time_down_event": {
            "event": "rally:end_rally"
          }
        }
      },
      "rally:tamed": {
        "minecraft:behavior.follow_owner": {
          "priority": 3,
          "speed_multiplier": 1.4, 
          "start_distance": 5,
          "stop_distance": 3,
          "can_teleport": false
        },
        "minecraft:flocking": {
            "influence_radius": 0.0,
            "cohesion_weight": 0.0,
            "goal_weight": 0.0,
            "separation_weight": 0.0
        }
      }
    },
    "components": {
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:type_family": {
        "family": [ "cod", "fish" ]
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 0.3
      },
      "minecraft:health": {
        "value": 3,
        "max": 3
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:movement": {
        "value": 0.12
      },
      "minecraft:underwater_movement": {
        "value": 0.12
      },
      "minecraft:movement.sway": {
        "sway_amplitude": 0.02,
        "sway_frequency": 0.5
      },
      "minecraft:navigation.generic": {
        "can_breach": false,
        "can_walk": false,
        "can_path_over_water": false,
        "can_sink": false,
        "can_swim": true,
        "is_amphibious": false,
        "using_door_annotation": true
      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:behavior.swim_idle": {
        "priority": 5
      },
      "minecraft:behavior.swim_wander": {
        "priority": 4,
        "interval": 10,
        "speed_multiplier": 0.2
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.25
      },
      "minecraft:physics": { "has_gravity": false },
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {},
      "minecraft:tameable": {
        "probability": 1.0,
        "tame_items": [],
        "tame_event": {
          "event": "minecraft:on_tame",
          "target": "self"
        }
      }
    },
    "events": {
      "minecraft:entity_spawned": {},
      "rally:start_rally": {
        "add": {
          "component_groups": [ "rally:rallied", "rally:tamed" ]
        }
      },
      "rally:end_rally": {
        "remove": {
          "component_groups": [ "rally:rallied", "rally:tamed" ]
        }
      },
      "minecraft:on_tame": {
        "add": {
          "component_groups": [ "rally:tamed" ]
        }
      }
    }
  }
}